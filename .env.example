# Copy to .env for local development (never commit real secrets).
PORT=8000
LOG_LEVEL=INFO

# Gemini Live API key for live/bridge/local_harness.py.
# The Live API needs a paid-tier (Tier 1) key.
GEMINI_API_KEY=

# Optional separate key for evals (python -m evals.run); falls back to
# GEMINI_API_KEY. A free-tier key may ONLY be used with the synthetic eval
# cases, never with real call data. See evals/README.md.
GEMINI_EVAL_API_KEY=
