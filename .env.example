# Copy to .env for local development (never commit real secrets).
PORT=8000
LOG_LEVEL=INFO

# Gemini Live API key for live/bridge/local_harness.py (and the bridge).
# Use a paid-tier key wherever real caller data is involved.
GEMINI_API_KEY=

# Optional separate key for evals (python -m evals.run); falls back to
# GEMINI_API_KEY. Free-tier keys work with the Live API, but have lower rate
# limits and their data may be used by Google, so use them only for synthetic
# eval data. See evals/README.md.
GEMINI_EVAL_API_KEY=
